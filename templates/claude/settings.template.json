{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["scripts/janitor.sh"],
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": ["[HOME]/.docker/run/docker.sock"]
    }
  },
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && mkdir -p .handoff && scripts/janitor.sh > .handoff/janitor-start.log 2>&1 || true", "timeout": 30 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && mkdir -p .handoff && (nohup scripts/janitor.sh --apply > .handoff/janitor-end.log 2>&1 &) ; true" } ] }
    ]
  }
}
